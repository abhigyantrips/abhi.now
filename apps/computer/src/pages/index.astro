---
import ComputerLayout from "@/layouts/computer-layout.astro";
import ComputerIcon from "@/components/computer-icon.astro";
import { applications } from "@/data/applications";
---

<ComputerLayout>
	<section
		id="launcher"
		class="launcher flex h-full flex-col overflow-hidden rounded-xl bg-white"
		aria-label="Applications and search"
	>
		<h1 class="sr-only">abhi.computer applications</h1>
		<div class="min-h-0 flex-1 overflow-y-auto p-4 md:p-6 lg:p-8">
			<label class="sr-only" for="app-search">Search applications and posts</label>
			<input
				id="app-search"
				class="mx-auto mb-8 block w-full max-w-xl rounded-lg border-0 px-4 py-3"
				type="search"
				placeholder="Search applications and posts…"
				autocomplete="off"
				spellcheck="false"
				aria-controls="post-results"
			/>
			<div class="application-grid grid grid-cols-2 gap-4 md:grid-cols-4 xl:grid-cols-6">
				{
					applications.map((app) => (
						<a
							class="application flex min-h-32 flex-col items-center justify-center gap-4 rounded-lg p-4 text-center"
							href={app.path}
							data-search={app.title.toLowerCase()}
							data-app-title={app.title}
							data-app-description={app.description}
						>
							<ComputerIcon name={app.id} class="size-16" />
							<span>{app.title}</span>
						</a>
					))
				}
			</div>
			<section id="post-results" class="mt-6" aria-label="Post search results" hidden>
				<p
					id="search-status"
					class="mb-4 text-sm text-neutral-600"
					role="status"
					aria-live="polite"
				>
				</p>
				<button id="search-retry" class="mb-4 rounded bg-white px-3 py-2" hidden>Try again</button>
				<div id="search-results" class="flex flex-col"></div>
			</section>
		</div>
	</section>
</ComputerLayout>
