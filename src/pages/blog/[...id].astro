---
import ReadingLayout from "@/layouts/reading-layout.astro";
import { getEntries } from "astro:content";
import { getCollection, render } from "astro:content";
import { formatReadingTime } from "@/lib/utils";

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) =>
		import.meta.env.DEV ? true : data.published
	);
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
		cacheKey: String(post.digest),
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const tags = await getEntries(post.data.tags || []);
---

<ReadingLayout
	route="/blog"
	post={{
		title: post.data.title,
		description: post.data.description,
		date: post.data.date.toLocaleString("en-DB", {
			day: "numeric",
			weekday: "long",
			month: "long",
			year: "numeric",
		}),
		readingTime: formatReadingTime(post.body ?? ""),
		url: `/blog/${post.id}`,
	}}
>
	<article class="e-content prose-content">
		<Content />
		<div class="not-prose font-gummy flex items-center justify-start gap-2 tracking-wider">
			{
				tags.map((tag) => (
					<abbr
						title={tag.data.description}
						class="p-category cursor-help rounded-lg bg-(--color-text)/10 px-3 py-1 text-sm text-(--color-text)/75 no-underline transition-colors duration-150"
					>
						#{tag.id}
					</abbr>
				))
			}
		</div>
	</article>
</ReadingLayout>
