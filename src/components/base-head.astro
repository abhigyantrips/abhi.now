---
import DocumentHead from "./document-head.astro";
import { ClientRouter } from "astro:transitions";
import type { SocialImage } from "@/types";
interface Props {
	title: string;
	description: string;
	image?: SocialImage;
	rssFeed?: { title: string; path: string };
}
---

<DocumentHead {...Astro.props} />
<!-- Annu Analytics -->
<script is:inline>
	(() => {
		const load = () => {
			try {
				if (localStorage.getItem("annu.disabled") === "true") return;
			} catch {}
			const s = document.createElement("script");
			s.src = "https://annu.abhi.now/script.js";
			s.async = true;
			s.dataset.siteId = "3a90c2c4-8cff-4861-8f64-23f04862ac13";
			s.dataset.domains = "abhi.now";
			s.dataset.heartbeat = "true";
			s.dataset.performance = "true";
			s.dataset.links = "true";
			document.head.appendChild(s);
		};
		if (document.readyState === "complete") setTimeout(load, 0);
		else window.addEventListener("load", load, { once: true });
	})();
</script>

<ClientRouter />
<!-- Global Theme Script -->
<script is:inline>
	function getThemePreference() {
		if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
			return localStorage.getItem("theme");
		}
		return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
	}

	function applyTheme(doc) {
		const isDark = getThemePreference() === "dark";
		doc.documentElement.classList.toggle("dark", isDark);
	}

	// Apply theme immediately on initial load
	applyTheme(document);

	// Apply theme to new document BEFORE swap to prevent flash
	document.addEventListener("astro:before-swap", (e) => {
		applyTheme(e.newDocument);
	});
</script>

<!-- Theme toggle and system-theme listener: standalone pages only. -->
<script is:inline>
	(() => {
		if (window.__abhiThemeSetup) return;
		window.__abhiThemeSetup = true;
		function setupThemeToggle() {
			const toggle = document.getElementById("theme-toggle");

			toggle?.addEventListener("click", () => {
				const isDark = document.documentElement.classList.contains("dark");
				const newTheme = isDark ? "light" : "dark";
				localStorage.setItem("theme", newTheme);
				document.documentElement.classList.toggle("dark", !isDark);
			});
		}

		document.addEventListener("astro:page-load", setupThemeToggle);

		window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
			if (!localStorage.getItem("theme")) {
				document.documentElement.classList.toggle("dark", e.matches);
			}
		});
	})();
</script>
