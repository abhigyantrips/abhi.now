---
import icons from "@/data/computer-icons.json";

interface Props {
	name: keyof typeof icons;
	class?: string;
}

const { name, class: className } = Astro.props;
const icon = icons[name];
---

{
	"image" in icon ? (
		<img
			src={icon.image}
			width="24"
			height="24"
			class:list={["computer-icon", className]}
			alt=""
			aria-hidden="true"
			draggable="false"
			decoding="async"
		/>
	) : (
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 48 48"
			width="24"
			height="24"
			class:list={["computer-icon", className]}
			aria-hidden="true"
			focusable="false"
		>
			<Fragment set:html={icon.body} />
		</svg>
	)
}

<style>
	.computer-icon {
		display: inline-block;
		flex-shrink: 0;
		vertical-align: middle;
		object-fit: contain;
	}
</style>
