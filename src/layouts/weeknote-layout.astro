---
import BaseHead from "@/components/base-head.astro";
import Container from "@/components/container.astro";
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";
import { slideFromBottom } from "@/lib/transitions";
import { getMonthColor } from "@/lib/month-colors";
import { SITE } from "@/consts";
import "@/styles/global.css";
import "@/styles/prose.css";

type Props = {
	title: string;
	description: string;
	fromDate: Date;
	toDate: Date;
	postUrl: string;
	readingTime?: string;
};

const { title, description, fromDate, toDate, postUrl, readingTime } = Astro.props;

const formatDate = (d: Date) =>
	d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });

const [key, ...rest] = title.split(" ");
const restTitle = rest.join(" ");

const monthColor = getMonthColor(fromDate);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE.TITLE}`} description={description} />
	</head>
	<body class="font-gummy">
		<Header section="weeknotes" />
		<main
			class="flex min-h-[calc(100vh-(--spacing(56)))] flex-1 flex-col pb-12 md:pb-36"
			transition:animate={slideFromBottom}
		>
			<Container size="md">
				<div
					class="h-entry flex flex-col pt-24 md:pt-48"
					style={`--month-color-light: ${monthColor.light}; --month-color-dark: ${monthColor.dark};`}
				>
					<div class="flex flex-col gap-1">
						<div class="flex items-center gap-2">
							<span class="weeknote-key font-semibold" aria-hidden="true">{key}</span>
							{
								readingTime && (
									<>
										<span class="text-(--color-text-muted)" aria-hidden="true">
											·
										</span>
										<span class="text-(--color-text-muted) uppercase">{readingTime}</span>
									</>
								)
							}
						</div>
						<h1 class="p-name text-3xl font-semibold">
							<span class="hidden">{key}</span>
							{restTitle}
						</h1>
						<p class="p-summary text-(--color-text-muted)">
							{description}
						</p>
						<time class="dt-start hidden" datetime={fromDate.toISOString()}>
							{formatDate(fromDate)}
						</time>
						<time class="dt-end hidden" datetime={toDate.toISOString()}>
							{formatDate(toDate)}
						</time>
						<a class="u-url hidden" href={postUrl}>
							{title}
						</a>
						<span class="p-author h-card hidden">
							<a class="p-name u-url" href={SITE.URL} rel="author">{SITE.AUTHOR}</a>
						</span>
					</div>
					<slot />
				</div>
			</Container>
		</main>

		<Footer />
	</body>
</html>

<style>
	.weeknote-key {
		color: var(--month-color-light);
	}

	:global(.dark) .weeknote-key {
		color: var(--month-color-dark);
	}
</style>
