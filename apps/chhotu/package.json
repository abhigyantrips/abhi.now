    "fast-png": "^8.0.0",
    "image-size": "^2.0.4",
    "jpeg-js": "^0.4.4",
    "marked": "^18.1.1",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@types/node": "^26.6.5",
    "@vite-pwa/astro": "^1.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "typescript": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
