{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"],
			"@now/*": ["./src/*"],
			"@content/*": ["../../content/*"]
		},
		"types": ["./worker-configuration.d.ts", "node"],
		"allowJs": true
	}
}
