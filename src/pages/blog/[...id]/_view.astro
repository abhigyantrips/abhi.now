---
import ReadingLayout from "@/layouts/reading-layout.astro";
import { getEntries } from "astro:content";
import { render, type CollectionEntry } from "astro:content";
import { formatBlogDate, formatReadingTime } from "@/lib/utils";
import { extractOpeningHtml } from "@/lib/blog-preview";
import { renderEntryHtml } from "@/lib/content-html";
import { renderCard } from "astro-cards/runtime";

interface Props {
	post: CollectionEntry<"blog">;
	embed?: import("@/lib/embed-policy").EmbedPage;
}
const { post } = Astro.props;
const { Content } = await render(post);
const tags = await getEntries(post.data.tags || []);
const date = formatBlogDate(post.data.date);
const readingTime = formatReadingTime(post.body ?? "");

// MDX entries render at runtime rather than storing HTML in the collection.
const html = post.rendered?.html ?? (await renderEntryHtml(post));

const image = await renderCard("blog", {
	title: post.data.title,
	description: post.data.description,
	date,
	readingTime,
	openingHtml: extractOpeningHtml(html),
}).catch((cause: unknown) => {
	throw new Error(
		`Cannot render blog preview for "${post.id}". Check src/cards/blog.astro and the Sour Gummy Fonts API configuration.`,
		{ cause }
	);
});

const embed = Astro.props.embed;
---

<ReadingLayout
	embed={embed}
	route="/blog"
	image={image}
	post={{
		title: post.data.title,
		description: post.data.description,
		date,
		readingTime,
		url: `/blog/${post.id}`,
	}}
>
	<article class="e-content prose-content">
		<Content />
		<div class="not-prose font-gummy flex items-center justify-start gap-2 tracking-wider">
			{
				tags.map((tag) => (
					<abbr
						title={tag.data.description}
						class="p-category cursor-help rounded-lg bg-(--color-text)/10 px-3 py-1 text-sm text-(--color-text)/75 no-underline transition-colors duration-150"
					>
						#{tag.id}
					</abbr>
				))
			}
		</div>
	</article>
</ReadingLayout>
