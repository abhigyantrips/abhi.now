---
import View from "./_view.astro";
import { getCollection } from "astro:content";
import { getEmbedBuildContext } from "@/lib/embed-cache";
export async function getStaticPaths() {
	const { page, cacheKey } = await getEmbedBuildContext();
	const entries = await getCollection("facets");
	return entries.map((facet) => ({
		params: { slug: facet.id },
		props: { facet, embed: page(`/whoami/${facet.id}`) },
		cacheKey: cacheKey([facet]),
	}));
}
---

<View {...Astro.props} />
