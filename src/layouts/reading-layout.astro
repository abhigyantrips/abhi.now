---
import EmbedHead from "@/components/embed-head.astro";
import BaseHead from "@/components/base-head.astro";
import Container from "@/components/container.astro";
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";
import { slideFromBottom } from "@/lib/transitions";
import { ROUTES, SITE } from "@/consts";
import type { SocialImage } from "@/types";
import "@/styles/global.css";
import "@/styles/prose.css";

type Props = {
	embed?: import("@/lib/embed-policy").EmbedPage;
	route: string;
	image?: SocialImage;
	post: {
		title: string;
		description: string;
		date: string;
		readingTime?: string;
		url: string;
	};
};

const { route, post, image } = Astro.props;

const currentRoute = ROUTES.find((r) => r.PATH === route || r.NAME === route);

if (!currentRoute) {
	throw new Error(`Route "${route}" not found in ROUTES`);
}
const { embed } = Astro.props;
---

<!doctype html>
<html lang="en" data-embed={embed && "computer"} data-embed-scope={embed?.scope}>
	<head>
		{
			embed ? (
				<EmbedHead
					embed={embed}
					title={`${post.title.toLowerCase()} | ${SITE.TITLE}`}
					description={post.description}
					image={image}
				/>
			) : (
				<BaseHead
					title={`${post.title.toLowerCase()} | ${SITE.TITLE}`}
					description={post.description}
					image={image}
				/>
			)
		}
	</head>
	<body class="font-gummy">
		{!embed && <Header section={currentRoute.NAME} />}
		<main
			class="flex min-h-[calc(100vh-(--spacing(56)))] flex-1 flex-col pb-12 md:pb-36"
			transition:animate={slideFromBottom}
		>
			<Container size="md">
				<div class={embed ? "h-entry flex flex-col pt-8" : "h-entry flex flex-col pt-24 md:pt-48"}>
					<div class="flex flex-col gap-2">
						{
							(post.date || post.readingTime) && (
								<div class="flex items-center gap-2 text-sm text-(--color-text-muted) uppercase">
									{post.date && (
										<time class="dt-published" datetime={post.date}>
											{post.date}
										</time>
									)}
									{post.date && post.readingTime && <span aria-hidden="true">·</span>}
									{post.readingTime && <span>{post.readingTime}</span>}
								</div>
							)
						}
						<h1 class="p-name text-3xl font-semibold">
							{post.title}
						</h1>
						<p class="p-summary text-(--color-text-muted)">{post.description}</p>
						{
							post.url && (
								<a class="u-url hidden" href={post.url}>
									{post.title}
								</a>
							)
						}
						<span class="p-author h-card hidden">
							<a class="p-name u-url" href={SITE.URL} rel="author">{SITE.AUTHOR}</a>
						</span>
					</div>
					<hr class="mt-4 border-t-2 border-dashed border-(--color-text-muted)/50" />
					<div class="not-prose mt-4 flex justify-start gap-2">
						<button
							id="download-pdf"
							class="pdf-btn font-gummy inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm"
						>
							<span
								class="pdf-btn-icon size-4 shrink-0"
								style="--icon-url: url(/icons/paper-clip-2.svg)"
								aria-hidden="true"></span>
							Download PDF
						</button>
						{
							post.url && (
								<a
									href={`${post.url}/plaintext`}
									class="pdf-btn font-gummy inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm no-underline"
								>
									<span
										class="pdf-btn-icon size-4 shrink-0"
										style="--icon-url: url(/icons/left-align.svg)"
										aria-hidden="true"
									/>
									Show Plaintext Version
								</a>
							)
						}
					</div>
					<slot />
				</div>
			</Container>
		</main>

		<Footer />
	</body>
</html>

<style>
	.pdf-btn {
		background-color: color-mix(in srgb, var(--color-text) 10%, transparent);
		color: var(--color-text-muted);
		text-decoration: none;
		transition: background-color 0.15s ease;
		cursor: pointer;
		border: none;
	}
	.pdf-btn:hover {
		background-color: color-mix(in srgb, var(--color-text) 18%, transparent);
		color: var(--color-text);
	}
	.pdf-btn-icon {
		display: inline-block;
		background-color: currentColor;
		mask: var(--icon-url) no-repeat center / contain;
		-webkit-mask: var(--icon-url) no-repeat center / contain;
	}

	@media print {
		.pdf-btn {
			display: none !important;
		}
	}
</style>

<script>
	function setupPdf() {
		const button = document.getElementById("download-pdf");
		if (!button || button.dataset.pdfReady) return;
		button.dataset.pdfReady = "true";
		document.getElementById("download-pdf")?.addEventListener("click", () => {
			window.print();
		});
	}
	document.addEventListener("astro:page-load", setupPdf);
	if (document.readyState === "loading")
		document.addEventListener("DOMContentLoaded", setupPdf, { once: true });
	else setupPdf();
</script>
