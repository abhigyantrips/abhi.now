---
import BaseHead from "@/components/base-head.astro";
import Container from "@/components/container.astro";
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";
import { slideFromBottom } from "@/lib/transitions";
import { getMonthColor } from "@/lib/month-colors";
import { SITE } from "@/consts";
import type { SocialImage } from "@/types";
import "@/styles/global.css";
import "@/styles/prose.css";

type Props = {
	title: string;
	description: string;
	fromDate: Date;
	toDate: Date;
	postUrl: string;
	readingTime?: string;
	image?: SocialImage;
};

const { title, description, fromDate, toDate, postUrl, readingTime, image } = Astro.props;

const formatDate = (d: Date) =>
	d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });

const [key, ...rest] = title.split(" ");
const restTitle = rest.join(" ");

const monthColor = getMonthColor(fromDate);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE.TITLE}`} description={description} image={image} />
	</head>
	<body class="font-gummy">
		<Header section="weeknotes" />
		<main
			class="flex min-h-[calc(100vh-(--spacing(56)))] flex-1 flex-col pb-12 md:pb-36"
			transition:animate={slideFromBottom}
		>
			<Container size="md">
				<div
					class="h-entry flex flex-col pt-24 md:pt-48"
					style={`--month-color-light: ${monthColor.light}; --month-color-dark: ${monthColor.dark};`}
				>
					<div class="flex flex-col gap-1">
						<div class="flex items-center gap-2">
							<span class="weeknote-key font-semibold" aria-hidden="true">{key}</span>
							{
								readingTime && (
									<>
										<span class="text-(--color-text-muted)" aria-hidden="true">
											·
										</span>
										<span class="text-(--color-text-muted) uppercase">{readingTime}</span>
									</>
								)
							}
						</div>
						<h1 class="p-name text-3xl font-semibold">
							<span class="hidden">{key}</span>
							{restTitle}
						</h1>
						<p class="p-summary text-(--color-text-muted)">
							{description}
						</p>
						<time class="dt-start hidden" datetime={fromDate.toISOString()}>
							{formatDate(fromDate)}
						</time>
						<time class="dt-end hidden" datetime={toDate.toISOString()}>
							{formatDate(toDate)}
						</time>
						<a class="u-url hidden" href={postUrl}>
							{title}
						</a>
						<span class="p-author h-card hidden">
							<a class="p-name u-url" href={SITE.URL} rel="author">{SITE.AUTHOR}</a>
						</span>
					</div>
					<hr class="mt-4 border-t-2 border-dashed border-(--color-text-muted)/50" />
					<div class="not-prose mt-4 flex justify-start gap-2">
						<button
							id="download-pdf"
							class="pdf-btn font-gummy inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm"
						>
							<span
								class="pdf-btn-icon size-4 shrink-0"
								style="--icon-url: url(/icons/paper-clip-2.svg)"
								aria-hidden="true"></span>
							Download PDF
						</button>
						<a
							href={`${postUrl}/plaintext`}
							class="pdf-btn font-gummy inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm no-underline"
						>
							<span
								class="pdf-btn-icon size-4 shrink-0"
								style="--icon-url: url(/icons/left-align.svg)"
								aria-hidden="true"></span>
							Show Plaintext Version
						</a>
					</div>
					<slot />
				</div>
			</Container>
		</main>

		<Footer />
	</body>
</html>

<script>
	document.addEventListener("astro:page-load", () => {
		document.getElementById("download-pdf")?.addEventListener("click", () => {
			window.print();
		});
	});
</script>

<style>
	.pdf-btn {
		background-color: color-mix(in srgb, var(--color-text) 10%, transparent);
		color: var(--color-text-muted);
		text-decoration: none;
		transition: background-color 0.15s ease;
		cursor: pointer;
		border: none;
	}
	.pdf-btn:hover {
		background-color: color-mix(in srgb, var(--color-text) 18%, transparent);
		color: var(--color-text);
	}
	.pdf-btn-icon {
		display: inline-block;
		background-color: currentColor;
		mask: var(--icon-url) no-repeat center / contain;
		-webkit-mask: var(--icon-url) no-repeat center / contain;
	}

	@media print {
		.pdf-btn {
			display: none !important;
		}
	}

	.weeknote-key {
		color: var(--month-color-light);
	}

	:global(.dark) .weeknote-key {
		color: var(--month-color-dark);
	}
</style>
