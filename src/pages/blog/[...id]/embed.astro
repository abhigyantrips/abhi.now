---
import View from "./_view.astro";
import { getCollection } from "astro:content";
import { getEmbedBuildContext } from "@/lib/embed-cache";
export async function getStaticPaths() {
	const { page, cacheKey } = await getEmbedBuildContext();
	const entries = await getCollection("blog", ({ data }) => import.meta.env.DEV || data.published);
	return entries.map((post) => ({
		params: { id: post.id },
		props: { post, embed: page(`/blog/${post.id}`) },
		cacheKey: cacheKey([post]),
	}));
}
---

<View {...Astro.props} />
