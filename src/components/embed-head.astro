---
import DocumentHead from "./document-head.astro";
import type { EmbedPage } from "@/lib/embed-policy";
import type { SocialImage } from "@/types";
interface Props {
	embed: EmbedPage;
	title: string;
	description: string;
	image?: SocialImage;
	rssFeed?: { title: string; path: string };
}
const { embed, ...metadata } = Astro.props;
---

<DocumentHead {...metadata} canonicalPath={embed.canonical} />
<meta name="robots" content="noindex" />
<style is:inline id="computer-cursors"></style>
<script is:inline src="/embed-bridge.js" data-development={import.meta.env.DEV ? "true" : undefined}
></script>
