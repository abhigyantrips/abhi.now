---
import BaseHead from "@/components/base-head.astro";
import Container from "@/components/container.astro";
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";
import { render } from "astro:content";
import { getCollection } from "astro:content";

import "@/styles/global.css";
import "@/styles/prose.css";

export async function getStaticPaths() {
	const links = await getCollection("links");

	return links.map((link) => ({
		params: { id: link.id },
		props: { link },
	}));
}

const { link } = Astro.props;
const { Content } = await render(link);

const publishedDate = link.data.date.toLocaleString("en-DB", {
	day: "numeric",
	month: "long",
	year: "numeric",
	hour: "2-digit",
	minute: "2-digit",
});
const displayDate = link.data.date.toLocaleString("en-DB", {
	day: "numeric",
	month: "long",
	year: "numeric",
});
const displayTime = link.data.date.toLocaleString("en-DB", {
	hour: "2-digit",
	minute: "2-digit",
});

function toDescription(body: string | undefined) {
	const text = (body ?? "")
		.replace(/```[\s\S]*?```/g, "")
		.replace(/`([^`]+)`/g, "$1")
		.replace(/!\[[^\]]*\]\([^)]*\)/g, "")
		.replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
		.replace(/[#>*_~\-\n]+/g, " ")
		.replace(/\s+/g, " ")
		.trim();

	return text.length > 160 ? `${text.slice(0, 157).trim()}...` : text;
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${link.data.link.title} | Abhigyan's Links`}
			description={toDescription(link.body) ||
				`A link saved by Abhigyan Trips: ${link.data.link.title}.`}
			type="article"
		/>
	</head>
	<body class="font-mono">
		<Header />
		<main class="flex min-h-[calc(100vh-(--spacing(38)))] flex-1 flex-col pb-12 md:pb-36">
			<Container size="md">
				<article
					id={link.id}
					class="link-entry h-entry mt-24 flex min-w-0 flex-col gap-4 bg-black/5 p-5 md:mt-48"
				>
					<div class="flex min-w-0 items-start justify-between gap-4">
						<a
							class="p-author h-card flex min-w-0 items-center gap-3 pr-4 no-underline!"
							href="https://abhi.now"
							rel="author"
						>
							<img
								class="u-photo size-12 shrink-0 border border-black/15 object-cover"
								src="https://abhi.now/headshot.png"
								alt=""
								width="48"
								height="48"
								loading="lazy"
								decoding="async"
							/>
							<span class="flex min-w-0 flex-col leading-tight">
								<span class="p-name truncate font-semibold">Abhigyan Trips</span>
								<span class="text-sm text-gray-500">abhi.now</span>
							</span>
						</a>

						<time
							class="dt-published flex shrink-0 flex-col items-end pt-1 text-right text-sm text-gray-500"
							datetime={link.data.date.toISOString()}
						>
							<span>{displayDate}</span>
							<span>{displayTime}</span>
						</time>
					</div>

					<div class="flex min-w-0 flex-col gap-1">
						<h1 class="p-name text-lg font-bold break-words">{link.data.link.title}</h1>
						<a class="u-bookmark-of text-sm break-all text-gray-500" href={link.data.link.url}>
							{link.data.link.url}
						</a>
					</div>

					<div class="e-content prose-content prose-sm min-w-0 md:prose-base">
						<Content />
					</div>

					<a class="u-url hidden" href={`/links/${link.id}`}>
						{link.data.link.title}
					</a>
				</article>
			</Container>
		</main>
		<Footer />
	</body>
</html>
