---
import View from "./_view.astro";
import { getCollection } from "astro:content";
export async function getStaticPaths() {
	const notes = await getCollection("weeknotes");
	return notes.map((note) => {
		const [year, week] = note.id.split("/");
		return {
			params: { year, week },
			props: { note },
			cacheKey: JSON.stringify([note.digest, new Date().getFullYear()]),
		};
	});
}
---

<View {...Astro.props} />
