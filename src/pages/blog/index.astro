---
import PageLayout from "@/layouts/page-layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const entries = await getCollection("blog", ({ data }) =>
	import.meta.env.DEV ? true : data.published
);

entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<PageLayout route="/blog">
	<div class="h-feed grid grid-cols-[auto_1fr] items-baseline gap-x-4 gap-y-2">
		<span class="p-name col-span-2 hidden">abhigyan trips's blog</span>
		{
			entries.map((post: CollectionEntry<"blog">) => (
				<div class="h-entry contents">
					<time
						class:list={[
							"dt-published text-sm text-(--color-text-muted)",
							!post.data.published && "text-(--color-text-muted)/50",
						]}
						datetime={post.data.date.toISOString()}
					>
						{post.data.date.toISOString().slice(0, 10)}
					</time>
					<a
						class="p-name u-url"
						href={`/blog/${post.id}`}
					>
						<span
							class:list={[
								"decoration-2 underline-offset-4 hover:underline",
								!post.data.published && "text-(--color-text-muted)/75 italic",
							]}
						>
							{post.data.title}
						</span>
					</a>
				</div>
			))
		}
	</div>
</PageLayout>
