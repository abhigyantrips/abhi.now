---
import View from "./_view.astro";
import { getSnippetFeed } from "@/lib/snippets";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
export const getStaticPaths = (async () => {
	const [collections, feed] = await Promise.all([
		getCollection("snippetCollections"),
		getSnippetFeed(),
	]);
	return collections.map((collection) => ({
		params: { slug: collection.data.permalink },
		props: { collection },
		cacheKey: JSON.stringify([
			new Date().getFullYear(),
			collection.digest,
			...feed
				.filter(({ post }) => post.data.collection.id === collection.id)
				.map(({ post }) => [post.id, post.digest]),
		]),
	}));
}) satisfies GetStaticPaths;
---

<View {...Astro.props} />
