---
import PageLayout from "@/layouts/page-layout.astro";
import WeeknotesView from "@/components/weeknotes-view.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("weeknotes");

const embed = Astro.props.embed;
---

<PageLayout embed={embed} route="/weeknotes">
	<WeeknotesView entries={entries} isDescending />
</PageLayout>
