---
import { getCollection, render } from "astro:content";
import WeeknoteLayout from "@/layouts/weeknote-layout.astro";
import { formatReadingTime } from "@/lib/utils";
import { getMonthColor } from "@/lib/month-colors";
import { extractFirstImage, formatWeeknoteDateRange } from "@/lib/weeknote-preview";
import { renderCard } from "astro-cards/runtime";

export async function getStaticPaths() {
	const notes = await getCollection("weeknotes");
	return notes.map((note) => {
		const [year, week] = note.id.split("/");
		return {
			params: { year, week },
			props: { note },
			cacheKey: String(note.digest),
		};
	});
}

const { note } = Astro.props;
const { Content } = await render(note);
const readingTime = formatReadingTime(note.body ?? "");
const [id, ...title] = note.data.title.split(" ");
const image = await (async () => {
	if (note.rendered?.html === undefined) {
		throw new Error("Rendered Markdown HTML is missing.");
	}
	return renderCard("weeknote", {
		id,
		title: title.join(" "),
		readingTime,
		monthColor: getMonthColor(note.data.fromDate).dark,
		dateRange: formatWeeknoteDateRange(note.data.fromDate, note.data.toDate),
		imageUrl: await extractFirstImage(note.rendered.html, note.filePath),
	});
})().catch((cause: unknown) => {
	throw new Error(
		`Cannot generate weeknote preview for "${note.id}". Check src/cards/weeknote.astro, the first Markdown image, and the Sour Gummy Fonts API configuration.`,
		{ cause }
	);
});
---

<WeeknoteLayout
	title={note.data.title}
	description={note.data.description}
	fromDate={note.data.fromDate}
	toDate={note.data.toDate}
	postUrl={`/weeknotes/${note.id}`}
	readingTime={readingTime}
	image={image}
>
	<article class="e-content prose-content">
		<Content />
	</article>
</WeeknoteLayout>
