---
import SnippetFeed from "@/components/snippet-feed.astro";
import PageLayout from "@/layouts/page-layout.astro";
import { formatSnippetDate, getSnippetFeed } from "@/lib/snippets";
import type { GetStaticPaths } from "astro";
import { renderCard } from "astro-cards/runtime";
import { getCollection, type CollectionEntry } from "astro:content";

export const getStaticPaths = (async () => {
	const collections = await getCollection("snippetCollections");
	return collections.map((collection) => ({
		params: { slug: collection.data.permalink },
		props: { collection },
		cacheKey: String(collection.digest),
	}));
}) satisfies GetStaticPaths;

interface Props {
	collection: CollectionEntry<"snippetCollections">;
}

const { collection } = Astro.props;
const snippets = (await getSnippetFeed(collection.id)).slice(0, 3).map(({ post }) => {
	if (post.rendered?.html === undefined) {
		throw new Error(
			`Cannot generate collection preview for "${collection.id}": snippet "${post.id}" is missing rendered Markdown HTML.`
		);
	}
	const { publishedDate, publishedTime } = formatSnippetDate(post.data.date);
	return { html: post.rendered.html, date: `${publishedDate}, ${publishedTime}` };
});
const image = await renderCard("collection", {
	title: collection.data.name,
	description: collection.data.description,
	snippets,
}).catch((cause: unknown) => {
	throw new Error(
		`Cannot render collection preview for "${collection.id}". Check src/cards/collection.astro and the Sour Gummy Fonts API configuration.`,
		{ cause }
	);
});
---

<PageLayout
	route="/snippets"
	title={collection.data.name}
	description={collection.data.description}
	image={image}
	icon="/icons/folder-empty.svg"
	rssFeed={{
		title: `abhigyan trips's ${collection.data.name}.`,
		path: `/snippets/${collection.data.permalink}/feed.xml`,
	}}
>
	<div class="-mt-5 mb-6 flex justify-end">
		<a
			href={`/snippets/${collection.data.permalink}/feed.xml`}
			class="feed-action-btn inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm"
		>
			<span
				class="btn-icon size-4 shrink-0"
				style="--icon-url: url(/icons/rss.svg)"
				aria-hidden="true"
			></span>
			Follow This Folder's RSS Feed
		</a>
	</div>
	<SnippetFeed
		collectionId={collection.id}
		feedPath={`/snippets/${collection.data.permalink}`}
		name={collection.data.name}
	/>
</PageLayout>

<style>
	.feed-action-btn {
		background-color: color-mix(in srgb, var(--color-text) 10%, transparent);
		color: var(--color-text-muted);
		text-decoration: none;
		transition: background-color 0.15s ease;
	}
	.feed-action-btn:hover {
		background-color: color-mix(in srgb, var(--color-text) 18%, transparent);
		color: var(--color-text);
	}
	.btn-icon {
		background-color: currentColor;
		mask: var(--icon-url) no-repeat center / contain;
		-webkit-mask: var(--icon-url) no-repeat center / contain;
	}
</style>
