---
import ComputerIcon from "@/components/computer-icon.astro";
import { applications, type ApplicationId } from "@/data/applications";
interface Props {
	appId?: ApplicationId;
}
const { appId } = Astro.props;
---

<div class="desktop-shell fixed inset-4 flex gap-4">
	<main class="workspace min-h-0 min-w-0 flex-1" aria-label="Desktop">
		<slot />
	</main>
	<footer
		transition:persist="desktop-taskbar"
		class="taskbar flex w-16 shrink-0 flex-col items-stretch rounded-xl bg-white"
	>
		<a
			href={Astro.url.pathname === "/" ? "/desktop/" : "/"}
			id="start"
			class="flex h-16 shrink-0 items-center justify-center rounded-t-xl p-3"
			aria-expanded={Astro.url.pathname === "/"}
			aria-label="Applications"
			title="Applications"><span class="start-mark size-8" aria-hidden="true"></span></a
		>
		<nav class="top-links flex min-h-0 flex-1 flex-col overflow-y-auto" aria-label="Top links">
			{
				applications
					.filter((app) => "topLink" in app)
					.map((app) => (
						<a
							href={app.path}
							class="flex min-h-16 shrink-0 items-center justify-center"
							data-taskbar={app.id}
							data-astro-prefetch="viewport"
							data-app-title={app.title}
							data-app-description={app.description}
							aria-current={app.id === appId ? "page" : undefined}
							aria-label={app.title}
						>
							<ComputerIcon name={app.id} class="size-8" />
						</a>
					))
			}
		</nav>
		<button
			id="control-panel-toggle"
			type="button"
			class="flex shrink-0 items-center justify-center rounded-b-xl py-4 text-sm uppercase tabular-nums"
			popovertarget="control-panel"
			aria-controls="control-panel"
			aria-expanded="false"
			aria-haspopup="dialog"
			aria-label="Open control panel"
		>
			<time id="clock" class="clock" aria-label="Local date and time">
				<span data-clock-date class="block"></span>
				<span data-clock-time class="block"></span>
			</time>
		</button>
	</footer>
</div>
<div id="app-tooltip" class="app-tooltip" role="tooltip" hidden>
	<strong data-tooltip-title></strong>
	<span data-tooltip-description></span>
</div>
<section
	id="control-panel"
	transition:persist="desktop-control-panel"
	class="control-panel"
	popover="auto"
	role="dialog"
	aria-labelledby="control-panel-title"
>
	<h2 id="control-panel-title" class="mb-4 text-sm font-medium">Control panel</h2>
	<div class="flex flex-col gap-2">
		<button id="theme-toggle" type="button" class="control-toggle" aria-pressed="false">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"
				><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"></circle><path
					d="M12 3a9 9 0 0 1 0 18Z"
					fill="currentColor"></path></svg
			>
			<span>Dark mode</span><span data-control-state class="control-state" aria-hidden="true"
				>Off</span
			>
		</button>
		<button id="analytics-toggle" type="button" class="control-toggle" aria-pressed="false">
			<svg
				width="20"
				height="20"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"><path d="M4 20V10m8 10V4m8 16v-7"></path></svg
			>
			<span>Analytics</span><span data-control-state class="control-state" aria-hidden="true"
				>Off</span
			>
		</button>
		<button id="fullscreen-toggle" type="button" class="control-toggle" aria-pressed="false">
			<svg
				width="20"
				height="20"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"></path></svg
			>
			<span>Fullscreen</span><span data-control-state class="control-state" aria-hidden="true"
				>Off</span
			>
		</button>
	</div>
	<p data-control-status class="control-status" role="status" aria-live="polite"></p>
</section>
